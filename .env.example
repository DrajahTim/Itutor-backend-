# Copy to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection. The database must have the pgvector extension
# enabled, since DocumentChunk.embedding is a vector column.
DB_NAME=itutor
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Groq API key for the chatbot and quiz generation: https://console.groq.com/keys
GROQ_API_KEY=

# Django secret key. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Optional. Overrides the default Groq model without a code change, which
# matters because Groq periodically decommissions hosted models. Must
# support response_format={"type": "json_object"} for quiz generation.
# Defaults to openai/gpt-oss-120b when unset.
# GROQ_MODEL=openai/gpt-oss-120b
