### Secrets ###############################################################
# .env holds DB_PASSWORD, GROQ_API_KEY and SECRET_KEY. Never commit it.
# Commit a .env.example with empty values instead, so collaborators know
# which variables they need to set.
.env
.env.*
!.env.example
*.pem
*.key

