### Virtual environments ##################################################
venv/
.venv/
env/
ENV/
virtualenv/

### Django ################################################################
# Local dev database. Migrations ARE committed (they're source, not
# artifacts) — only the database file itself is ignored.
*.sqlite3
*.sqlite3-journal
db.sqlite3

# collectstatic output — regenerated on deploy, never edited by hand.
staticfiles/
static_root/

# User-uploaded content. media/ is currently ~47 MB of course PDFs, which
# is both bloat and likely copyrighted textbook material. In production
# this belongs in object storage (S3 or similar), not the repo.
media/

*.log
django_debug.log
celerybeat-schedule
celerybeat.pid

